{
  "expo": {
    "name": "Exam Tayari",
    "slug": "imtihan-hub",
    "scheme": "imtihanhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F8FC",
    "primaryColor": "#1D4ED8",
    "description": "Pakistan exam preparation: Matric & Inter MCQs, MDCAT, ECAT, NUST NET, NTS, CSS, PPSC, FPSC mock tests, board results, roll number slips, date sheets, past papers, merit calculators and scholarships.",
    "ios": {
      "bundleIdentifier": "com.imtihanhub.mza",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.imtihanhub.mza",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#FFFFFF", "image": "./assets/splash-icon.png", "imageWidth": 180 }],
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#1D4ED8", "defaultChannel": "study" }],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2214888899948620~5209271593",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 26, "enableMinifyInReleaseBuilds": true, "enableShrinkResourcesInReleaseBuilds": true } }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withNoNativeAdValidator",
      "expo-sharing"
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "router": {} }
  }
}
